{
  "name": "@cipherzip/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run bundle",
    "bundle": "esbuild dist/index.js --bundle --platform=node --format=cjs --target=node18 --outfile=dist/cipherzip-core.bundle.cjs",
    "test": "vitest run",
    "test:e2e": "vitest run e2e",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cipherzip/shared": "*",
    "archiver": "^7.0.1",
    "qrcode": "^1.5.4",
    "uuid": "^11.0.3",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

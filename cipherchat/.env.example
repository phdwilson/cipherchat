# ===== CipherChat 环境变量配置模板 =====
# 复制为 .env 并填入实际值：cp .env.example .env

# ---- 必填 ----

# SQLite 数据库连接串（相对路径基于 prisma/ 目录）
DATABASE_URL=

# ---- 可选（留空使用内置默认值）----

# WebSocket 中继服务端口
WS_PORT=3003

# 聊天单文件大小上限（字节），默认 1GiB
MAX_CHAT_FILE_BYTES=

# 网盘单文件大小上限（字节），默认 5GiB
MAX_DRIVE_FILE_BYTES=

# 每个网盘仓库的配额（字节），默认 20GiB
DRIVE_QUOTA_BYTES=

# 会话有效期（毫秒），默认 7 天
SESSION_TTL_MS=

# 每个频道最大消息条数（0 = 不限制；超出后随机触发裁剪最旧消息）
MAX_MESSAGES_PER_CHANNEL=

# 密文分块存储目录（生产建议绝对路径）
DATA_DIR=data

# 说明：
# - 本项目不使用 SHARE_SECRET / NEXT_PUBLIC_TURN_URL 环境变量；
#   邀请令牌的服务器主密钥由服务端首次启动时自动生成并存入数据库 ServerSecret 表，
#   TURN 中继配置在管理员后台（/admin）填写，存于 AdminConfig 表。
